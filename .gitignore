# Dependency directories
/node_modules/
/.yarn/

# Production directories
/dist/
//build/

# Environment files
/.env*
/.secret*

# Logs
/*.log
/.pnpm-debug.log*
/yarn-debug.log*
/lerna-debug.log*

# TypeScript
/.*.tsbuildinfo
/out-*/

# IDE/vscode
/.vscode/
/.intellisense/
/.nav/

# Production builds
/.next/
/storybook-static/

# Misc
/.DS_Store/
/Thumbs.db